# Optional local development configuration; no secrets or cloud accounts.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/demo.sqlite
# The frontend proxy's dependency port. Set 3001 only for the documented fault exercise.
API_PORT=3000
APP_ENV=local
AUTH_MODE=anonymous
DATABASE_BACKEND=sqlite
# OIDC/cloud candidates below are comments, not working credentials/deployment inputs.
# API requires tenant-specific issuer/JWKS, API access-token audience/role/scope.
# OIDC_ISSUER=https://identity.example.test/tenant
# OIDC_JWKS_URI=https://identity.example.test/tenant/jwks
# OIDC_AUDIENCE=morrow-api
# OIDC_REQUIRED_ROLE=Demo.User
# OIDC_REQUIRED_SCOPE=cart
# ALLOWED_ORIGINS=https://shop.example.test
# SQL_SERVER=morrow.database.windows.net
# SQL_DATABASE=morrow
# SQL_CLIENT_ID=<explicit-runtime-managed-identity-client-id>
# SQL_MIGRATOR_CLIENT_ID=<different-approved-migrator-client-id>
# Frontend HTTPS candidate:
# PROXY_MODE=https
# API_ORIGIN=https://approved-api.internal.example.test
# TRUSTED_API_HOST=approved-api.internal.example.test
# DNS_RESOLVER=<reviewed-IPv4-resolver>
# OIDC_CLIENT_ID=<public-SPA-client-id>
# OIDC_SCOPES=openid api://approved-api/cart
# OIDC_CONNECT_ORIGIN=https://identity.example.test
# PUBLIC_ORIGIN=https://shop.example.test
