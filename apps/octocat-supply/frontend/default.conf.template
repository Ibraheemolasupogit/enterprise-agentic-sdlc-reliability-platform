server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 16k;
  resolver ${DNS_RESOLVER} valid=5s;
  set $api "${API_UPSTREAM}";
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${OIDC_CONNECT_ORIGIN}; base-uri 'none'; frame-ancestors 'none'" always;
  error_page 502 503 504 =503 /dependency-unavailable;
  error_page 413 =413 /body-too-large;
  location = /body-too-large {
    internal;
    default_type application/json;
    return 413 '{"code":"BODY_TOO_LARGE","message":"Request body exceeds 16 KiB.","requestId":"$request_id"}';
  }
  location = /dependency-unavailable {
    internal;
    default_type application/json;
    return 503 '{"code":"UPSTREAM_UNAVAILABLE","message":"The shop is temporarily unavailable.","requestId":"$request_id"}';
  }
  location /api {
    include /tmp/upstream.conf;
    proxy_connect_timeout 1s;
    proxy_read_timeout 2s;
    proxy_intercept_errors on;
  }
  location = /health/ready {
    include /tmp/upstream.conf;
    proxy_connect_timeout 1s;
    proxy_read_timeout 2s;
    proxy_intercept_errors on;
  }
  location = /health/live {
    default_type application/json;
    return 200 '{"status":"live"}';
  }
  location = /auth-config.json {
    alias /tmp/auth-config.json;
    default_type application/json;
    add_header Cache-Control no-store;
  }
  location / { try_files $uri /index.html; }
}
